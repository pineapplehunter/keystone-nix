-    }
+        ssize_t bl_size = load_image_size(rvs->rom, rom, rom_size);
+        if (bl_size < 0) {
+            error_report("could not load ROM image");
+            exit(1);
+        }
+
+        rom_add_blob_fixed_as("mrom.reset", rom, bl_size,
+                              rom_base, &address_space_memory);
+        g_free(rom);
+
+        /* Place the FDT after the image, including alignment in the bound. */
+        size_t fdt_offset = QEMU_ALIGN_UP((size_t)bl_size, 4);
+        size_t fdt_size;
+
+        if (fdt_pack(machine->fdt)) {
+            error_report("could not pack device tree");
+            exit(1);
+        }
+        fdt_size = fdt_totalsize(machine->fdt);
+        if (fdt_offset > rom_size || fdt_size > rom_size - fdt_offset) {
+            error_report("not enough ROM space to store device tree");
+            exit(1);
+        }
+
+        rom_add_blob_fixed_as("mrom.fdt", machine->fdt, fdt_size,
+                              rom_base + fdt_offset, &address_space_memory);
+
+    } else {
+        if (!riscv_is_32bit(harts)) {
