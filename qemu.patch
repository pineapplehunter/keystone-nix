-    } else {
-        reset_vec[3] = 0x0202b583;   /*     ld     a1, 32(t0) */
-        reset_vec[4] = 0x0182b283;   /*     ld     t0, 24(t0) */
-    }
+    if (rvs->rom) {
+        uint8_t *rom = g_malloc(rom_size);
